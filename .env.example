# Moteur d'audit
PSI_API_KEY=
BROWSERLESS_TOKEN=
BROWSERLESS_URL=https://production-sfo.browserless.io
EXA_API_KEY=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=          # google/gemini-3.5-flash

# Jobs d'audit durables (WDK)
AUDIT_JOBS_SECRET=         # header x-audit-secret de /api/audit/jobs (n8n, webhook Stripe) ; absent = endpoint ferme
AUDIT_REVIEW_SECRET=       # signe les tokens HMAC des liens de review PDF Pro (/audit/review/<jobId>?token=...)
STRIPE_SECRET_KEY=         # sk_live_... : refund automatique des audits Pro en echec definitif
STRIPE_WEBHOOK_SECRET=     # whsec_... : verification des signatures du webhook Stripe (checkout.session.completed)
NEXT_PUBLIC_SITE_URL=      # ex. https://www.aurentia.agency : base des liens de review postes sur Slack
