# Force pnpm à télécharger les binaires natifs linux-x64 (glibc) au build Vercel,
# en plus de la plateforme locale. Indispensable pour sharp : sans ça, le runtime
# Vercel ne trouve pas libvips (ERR_DLOPEN_FAILED) et tous les steps WDK plantent.
supportedArchitectures.os[]=current
supportedArchitectures.os[]=linux
supportedArchitectures.cpu[]=current
supportedArchitectures.cpu[]=x64
supportedArchitectures.libc[]=current
supportedArchitectures.libc[]=glibc
node-linker=hoisted
